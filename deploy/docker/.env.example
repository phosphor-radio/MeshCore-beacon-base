# Copy to .env and change what differs on this Pi. The defaults suit the first user of a Raspberry Pi OS install.

# The user the container runs as (`id -u`, `id -g`), so ./data belongs to you.
BEACON_UID=1000
BEACON_GID=1000
# The group that owns the serial device (`ls -ln /dev/ttyACM0`; dialout is 20 on Raspberry Pi OS and Debian).
BEACON_TTY_GID=20
# Time zone for the times beaconctl prints.
TZ=UTC
# The image tag to run (set by the bundle).
BEACON_VERSION=latest

# The map and API (docs/web.md). Which address on the Pi the web port is published on: 0.0.0.0 is every interface, so a laptop or phone on the
# network can open http://<the Pi>:8080/; 127.0.0.1 keeps it to the Pi itself. The page is plain HTTP.
BEACON_WEB_BIND=0.0.0.0
# The port on the Pi (inside the container it is always 8080; web.port in the configuration does not apply there).
BEACON_WEB_PORT=8080
